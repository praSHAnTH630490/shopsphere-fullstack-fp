# =================================================================
# ShopSphere — Environment Configuration Template
# Duplicate this file as .env and customize values for your environment.
# NEVER commit real passwords or production secrets to version control.
# =================================================================

# -----------------------------------------------------------------
# Backend Server Configuration
# -----------------------------------------------------------------
# Port on which the Spring Boot application listens (default: 8080)
PORT=8080

# -----------------------------------------------------------------
# MySQL Database Configuration
# -----------------------------------------------------------------
# JDBC connection URL to MySQL 8.0+ database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/online_store?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database user credential
SPRING_DATASOURCE_USERNAME=root

# Database user password (replace with your local MySQL password)
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# -----------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------
# Base64-encoded secret key used for signing HS256 / HS384 / HS512 JWT tokens
# Generate using: openssl rand -base64 32
APP_JWT_SECRET=your_base64_encoded_32_byte_secret_key_minimum_256_bits_here

# JWT token expiration in milliseconds (86400000 ms = 24 hours)
APP_JWT_EXPIRATION=86400000

# -----------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------
# Comma-separated list of frontend origins permitted to make cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------
# REST API base URL consumed by Axios
VITE_API_BASE_URL=http://localhost:8080/api
